# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Postgres + PostGIS（Compose 默认值；本机直连用 127.0.0.1）
POSTGRES_USER=ecochronos
POSTGRES_PASSWORD=ecochronos_local_dev
POSTGRES_DB=ecochronos
POSTGRES_DSN=postgresql://ecochronos:ecochronos_local_dev@127.0.0.1:5432/ecochronos

# MinIO（仅本地开发的假凭证，勿用于生产）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=ecochronos
MINIO_SECRET_KEY=ecochronos_local_dev_minio
MINIO_BUCKET=ecochronos
MINIO_SECURE=false

# Optional. Empty = HTTP PUT /archive/... and PUT /chunks are disabled
# (read-only public archive + metadata search). Set only for trusted local ingest.
ARCHIVE_UPLOAD_TOKEN=

# Daily ingest (OpenAQ v3 HTTP JSON → $DATA_DIR/raw/openaq/YYYY-MM-DD/)
# Register a free key at https://explore.openaq.org and put it here.
DATA_DIR=data
INGEST_SOURCE=openaq
INGEST_SCHEDULE_ENABLED=false
INGEST_INTERVAL_SECONDS=86400
INGEST_SKIP_EXISTING=false
INGEST_HTTP_TIMEOUT_SECONDS=30
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENAQ_API_KEY=
OPENAQ_LIMIT=100
# Optional ISO 3166-1 alpha-2 country filter, e.g. US
OPENAQ_ISO=

# Local batch pipeline (no secrets). CSV in, Parquet + sha256 out.
STAGING_DIR=data/staging
PROCESSED_DIR=data/processed
RESAMPLE_RULE=daily_mean_by_station
OUTPUT_FORMAT=parquet
